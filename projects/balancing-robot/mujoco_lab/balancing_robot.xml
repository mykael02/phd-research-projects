<mujoco model="Michael Agbo - balancing robot starter">
  <compiler angle="degree" inertiafromgeom="false"/>
  <option timestep="0.001" gravity="0 0 -9.81" integrator="implicitfast" solver="Newton" iterations="100" cone="elliptic"/>
  <visual>
    <global offwidth="1280" offheight="900"/>
    <quality shadowsize="2048"/>
    <headlight diffuse="0.7 0.7 0.7" ambient="0.3 0.3 0.3"/>
  </visual>
  <default>
    <geom friction="1 0.005 0.0001" condim="4" solref="0.005 1" solimp="0.95 0.99 0.001"/>
    <motor ctrllimited="true" ctrlrange="-0.35 0.35"/>
  </default>
  <asset>
    <texture name="tiles" type="2d" builtin="checker" rgb1="0.83 0.87 0.89" rgb2="0.73 0.79 0.82" width="512" height="512"/>
    <material name="floor" texture="tiles" texrepeat="20 20" texuniform="true" reflectance="0.1"/>
  </asset>
  <worldbody>
    <light pos="0 -2 3" dir="0 0 -1" directional="true"/>
    <geom name="ground" type="plane" size="5 5 0.1" material="floor"/>
    <body name="base" pos="0 0 0.0452">
      <freejoint name="floating_base"/>
      <!-- Base total 0.35 kg = chassis 0.11 + two wheels of 0.12 kg. -->
      <inertial pos="0 0 0" mass="0.11" diaginertia="0.0002 0.0002 0.0002"/>
      <geom name="axle" type="cylinder" size="0.009 0.115" axisangle="1 0 0 90" rgba="0.55 0.62 0.67 1"/>
      <geom name="body_support" type="box" pos="0 0 0.045" size="0.016 0.025 0.045" rgba="0.35 0.42 0.47 1" contype="0" conaffinity="0"/>
      <body name="torso" pos="0 0 0.18">
        <inertial pos="0 0 0" mass="1.2" diaginertia="0.012 0.012 0.004"/>
        <geom name="body_shell" type="box" size="0.0425 0.0725 0.10" rgba="0.03 0.48 0.54 1"/>
        <geom name="front_panel" type="box" pos="0.045 0 0" size="0.003 0.0525 0.045" rgba="0.08 0.15 0.21 1" contype="0" conaffinity="0"/>
        <site name="body_com" type="sphere" size="0.008" rgba="1 0.78 0.12 1"/>
      </body>
      <body name="left_wheel" pos="0 0.115 0">
        <joint name="left_axle" type="hinge" axis="0 1 0"/>
        <inertial pos="0 0 0" mass="0.12" diaginertia="0.00007 0.00012 0.00007"/>
        <geom name="left_tyre" type="cylinder" size="0.045 0.0175" axisangle="1 0 0 90" rgba="0.10 0.15 0.20 1"/>
        <geom type="box" size="0.030 0.018 0.003" rgba="0.85 0.89 0.91 1" contype="0" conaffinity="0"/>
      </body>
      <body name="right_wheel" pos="0 -0.115 0">
        <joint name="right_axle" type="hinge" axis="0 1 0"/>
        <inertial pos="0 0 0" mass="0.12" diaginertia="0.00007 0.00012 0.00007"/>
        <geom name="right_tyre" type="cylinder" size="0.045 0.0175" axisangle="1 0 0 90" rgba="0.10 0.15 0.20 1"/>
        <geom type="box" size="0.030 0.018 0.003" rgba="0.85 0.89 0.91 1" contype="0" conaffinity="0"/>
      </body>
    </body>
  </worldbody>
  <contact>
    <exclude body1="base" body2="left_wheel"/>
    <exclude body1="base" body2="right_wheel"/>
    <exclude body1="torso" body2="left_wheel"/>
    <exclude body1="torso" body2="right_wheel"/>
  </contact>
  <actuator>
    <motor name="left_motor" joint="left_axle" gear="1"/>
    <motor name="right_motor" joint="right_axle" gear="1"/>
  </actuator>
</mujoco>
